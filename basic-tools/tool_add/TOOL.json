{
  "name": "tool_add",
  "version": "2.0.0",
  "contractVersion": "2.0.0",
  "description": "按需求创建、转换和管理 pi 工具。",
  "whenToUse": [
    "需要生成工具、转换技能或维护工具注册表"
  ],
  "notFor": [
    "执行工具业务或修改运行时源码"
  ],
  "kind": "agent",
  "handler": "tool_add",
  "input": {
    "type": "object",
    "properties": {
      "request": {
        "type": "string",
        "maxLength": 8000,
        "description": "用自然语言说明要创建、转换或管理什么工具。"
      }
    },
    "required": [
      "request"
    ],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "list",
          "inspect",
          "validate",
          "add",
          "convert_skill",
          "create_tool",
          "disable",
          "enable"
        ]
      },
      "tools": {
        "type": "array",
        "maxItems": 200,
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 64
            },
            "description": {
              "type": "string",
              "maxLength": 2000
            },
            "input": {
              "type": "object",
              "additionalProperties": true,
              "description": "输入 JSON Schema。"
            },
            "output": {
              "type": "object",
              "additionalProperties": true,
              "description": "输出 JSON Schema。"
            }
          },
          "required": [
            "name",
            "description"
          ],
          "additionalProperties": false
        }
      },
      "errors": {
        "type": "array",
        "maxItems": 50,
        "items": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "permissions": {
    "read": true,
    "write": false,
    "bash": false,
    "network": false
  },
  "limits": {
    "maxInputBytes": 2097152,
    "maxResultBytes": 30000,
    "jobTimeoutMs": 600000
  },
  "execution": {
    "defaultMode": "sync",
    "notifyOnIdle": false,
    "asyncByDefault": false
  },
  "exposure": "direct",
  "namespace": "tool",
  "agent": {
    "instructions": "agent/AGENT.md",
    "workflow": "agent/WORKFLOW.md",
    "examples": "agent/EXAMPLES.md",
    "tools": [
      "read",
      "grep",
      "find",
      "ls"
    ],
    "maxTurns": 30,
    "sessionScope": "project",
    "memoryScope": "project",
    "resolution": "user-first",
    "createProjectIfMissing": false,
    "requireProjectTrust": false,
    "contractRange": "^2.0.0"
  }
}
