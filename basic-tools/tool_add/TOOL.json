{
  "name": "tool_add",
  "version": "1.0.0",
  "contractVersion": "1.0.0",
  "description": "管理 pi-tool-runtime 的工具：列出、检查、校验、添加工具，把技能目录转换成工具，启用或停用已注册的工具。需要创建新工具、查看现有工具的契约、或判断一个清单是否可用时使用。",
  "whenToUse": [
    "需要把一个技能目录转换成可用的工具",
    "需要查看已注册工具的名称、种类与说明",
    "需要检查某个工具的输入输出契约与 agent 文件",
    "需要添加、启用或停用一个工具"
  ],
  "notFor": [
    "需要直接执行某个工具的业务逻辑",
    "需要修改运行时源码或服务监督逻辑"
  ],
  "kind": "direct",
  "handler": "tool_add",
  "input": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": ["list", "inspect", "validate", "add", "convert_skill", "disable", "enable"],
        "description": "要执行的管理动作。"
      },
      "name": {
        "type": "string",
        "description": "工具名称，用于 inspect、disable、enable，或在添加时覆盖清单中的名称。"
      },
      "scope": {
        "type": "string",
        "enum": ["project", "user"],
        "description": "写入位置：project 写入项目 .pi/tools，user 写入 agent 目录的 tools。默认 project。"
      },
      "source": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["manifest", "skill", "script"],
            "description": "来源类型。"
          },
          "path": {
            "type": "string",
            "description": "来源路径。convert_skill 指向 SKILL.md，add 指向 TOOL.json 或工具目录。"
          }
        },
        "required": ["type"],
        "additionalProperties": false,
        "description": "添加或转换的来源。"
      },
      "manifest": {
        "type": "object",
        "description": "要校验或添加的完整工具清单对象。"
      },
      "instructions": {
        "type": "string",
        "description": "agent 工具的系统提示内容，写入 AGENT.md。"
      },
      "workflow": {
        "type": "string",
        "description": "agent 工具的执行流程，写入 WORKFLOW.md。"
      },
      "examples": {
        "type": "string",
        "description": "可选示例，写入 EXAMPLES.md。"
      },
      "replace": {
        "type": "boolean",
        "description": "目标目录已存在时是否覆盖。默认 false。"
      },
      "activate": {
        "type": "boolean",
        "description": "写入后是否立即加入 pi 的可用工具列表。默认 true。"
      }
    },
    "required": ["action"],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": ["list", "inspect", "validate", "add", "convert_skill", "disable", "enable"]
      },
      "name": { "type": "string", "maxLength": 64 },
      "version": { "type": "string", "maxLength": 32 },
      "kind": { "type": "string", "enum": ["direct", "agent"] },
      "scope": { "type": "string", "enum": ["project", "user", "package"] },
      "dir": { "type": "string", "maxLength": 1000 },
      "description": { "type": "string", "maxLength": 2000 },
      "source": { "type": "string", "maxLength": 1000 },
      "conversionMode": { "type": "string", "enum": ["agent", "deterministic"] },
      "converterAgent": { "type": "string", "maxLength": 1000 },
      "enabled": { "type": "boolean" },
      "whenToUse": { "type": "array", "items": { "type": "string", "maxLength": 500 }, "maxItems": 20 },
      "notFor": { "type": "array", "items": { "type": "string", "maxLength": 500 }, "maxItems": 20 },
      "tools": {
        "type": "array",
        "maxItems": 200,
        "items": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "maxLength": 64 },
            "version": { "type": "string", "maxLength": 32 },
            "kind": { "type": "string", "enum": ["direct", "agent"] },
            "scope": { "type": "string", "enum": ["project", "user", "package"] },
            "description": { "type": "string", "maxLength": 2000 }
          },
          "required": ["name", "version", "kind", "scope", "description"],
          "additionalProperties": false
        }
      },
      "services": {
        "type": "array",
        "maxItems": 50,
        "items": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "maxLength": 64 },
            "type": { "type": "string", "enum": ["script", "daemon"] },
            "protocol": { "type": "string", "maxLength": 64 },
            "lifecycle": { "type": "string", "maxLength": 32 },
            "start": { "type": "string", "maxLength": 32 }
          },
          "required": ["name", "type"],
          "additionalProperties": false
        }
      },
      "inputFields": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "maxLength": 64 },
            "type": { "type": "string", "maxLength": 32 },
            "required": { "type": "boolean" },
            "description": { "type": "string", "maxLength": 1000 }
          },
          "required": ["name", "type", "required"],
          "additionalProperties": false
        }
      },
      "outputFields": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "maxLength": 64 },
            "type": { "type": "string", "maxLength": 32 },
            "required": { "type": "boolean" },
            "description": { "type": "string", "maxLength": 1000 }
          },
          "required": ["name", "type", "required"],
          "additionalProperties": false
        }
      },
      "agentFiles": {
        "type": "object",
        "properties": {
          "instructions": { "type": "string", "maxLength": 200 },
          "workflow": { "type": "string", "maxLength": 200 },
          "examples": { "type": "string", "maxLength": 200 },
          "tools": { "type": "array", "items": { "type": "string", "maxLength": 32 }, "maxItems": 20 }
        },
        "required": ["instructions", "workflow", "tools"],
        "additionalProperties": false
      },
      "errors": { "type": "array", "items": { "type": "string", "maxLength": 2000 }, "maxItems": 50 },
      "warnings": { "type": "array", "items": { "type": "string", "maxLength": 2000 }, "maxItems": 50 }
    },
    "required": ["action"],
    "additionalProperties": false
  },
  "permissions": {
    "read": true,
    "write": true,
    "bash": false,
    "network": false
  },
  "limits": {
    "maxInputBytes": 2097152,
    "maxResultBytes": 30000,
    "jobTimeoutMs": 600000
  },
  "execution": {
    "defaultMode": "sync",
    "notifyOnIdle": false
  },
  "exposure": "direct",
  "namespace": "tool"
}
