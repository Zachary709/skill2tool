{
  "name": "tool_add",
  "version": "1.0.0",
  "contractVersion": "1.0.0",
  "description": "管理 pi-tool-runtime 的工具：列出、检查、校验、添加工具，把技能目录转换成工具，按名称和需求生成新工具，启用或停用已注册的工具。需要创建新工具、查看现有工具的契约、或判断一个清单是否可用时使用。",
  "whenToUse": [
    "需要按名称和需求生成一个新工具",
    "需要把一个技能目录转换成可用的工具",
    "需要查看已注册工具的名称、种类与说明",
    "需要检查某个工具的输入输出契约与 agent 文件",
    "需要添加、启用或停用一个工具"
  ],
  "notFor": [
    "需要直接执行某个工具的业务逻辑",
    "需要修改运行时源码或服务监督逻辑"
  ],
  "kind": "agent",
  "handler": "tool_add",
  "input": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "list",
          "inspect",
          "validate",
          "add",
          "convert_skill",
          "create_tool",
          "disable",
          "enable"
        ],
        "description": "要执行的管理动作。"
      },
      "name": {
        "type": "string",
        "description": "工具名称。inspect、enable、disable 用它定位工具，create_tool 用作新工具名。"
      },
      "scope": {
        "type": "string",
        "enum": [
          "project",
          "user"
        ],
        "description": "写入位置。默认 project。"
      },
      "sourcePath": {
        "type": "string",
        "description": "来源路径。add 指向 TOOL.json 或工具目录，convert_skill 指向 SKILL.md。"
      },
      "manifest": {
        "type": "object",
        "description": "validate 或 add 使用的完整工具清单。"
      },
      "requirements": {
        "type": "string",
        "maxLength": 8000,
        "description": "create_tool 的完整需求：做什么、输入、输出、涉及的脚本或服务。"
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "list",
          "inspect",
          "validate",
          "add",
          "convert_skill",
          "create_tool",
          "disable",
          "enable"
        ]
      },
      "tools": {
        "type": "array",
        "maxItems": 200,
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 64
            },
            "description": {
              "type": "string",
              "maxLength": 2000
            },
            "input": {
              "type": "object",
              "additionalProperties": true,
              "description": "inspect 时的输入 JSON Schema。"
            },
            "output": {
              "type": "object",
              "additionalProperties": true,
              "description": "inspect 时的输出 JSON Schema。"
            }
          },
          "required": [
            "name",
            "description"
          ],
          "additionalProperties": false
        }
      },
      "errors": {
        "type": "array",
        "maxItems": 50,
        "items": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "permissions": {
    "read": true,
    "write": false,
    "bash": false,
    "network": false
  },
  "limits": {
    "maxInputBytes": 2097152,
    "maxResultBytes": 30000,
    "jobTimeoutMs": 600000
  },
  "execution": {
    "defaultMode": "sync",
    "notifyOnIdle": false,
    "asyncByDefault": false
  },
  "exposure": "direct",
  "namespace": "tool",
  "agent": {
    "instructions": "agent/AGENT.md",
    "workflow": "agent/WORKFLOW.md",
    "examples": "agent/EXAMPLES.md",
    "tools": [
      "read",
      "grep",
      "find",
      "ls"
    ],
    "maxTurns": 30,
    "sessionScope": "project",
    "memoryScope": "project",
    "resolution": "user-first",
    "createProjectIfMissing": false,
    "requireProjectTrust": false,
    "contractRange": "^1.0.0"
  }
}
