{
  "name": "service_keeper",
  "version": "1.0.0",
  "contractVersion": "1.0.0",
  "description": "检查并恢复控制器上已登记的常驻服务：读服务登记表，探测健康与就绪接口，确认 systemd 用户单元状态，单元停止或健康检查失败时执行登记表里的启动或重启命令，重新检查后报告当前状态。当工具或任务依赖的本地服务不可用、需要判断谁在运行、或服务需要一次受控恢复时使用。",
  "whenToUse": [
    "已登记的本地服务无响应",
    "需要确认某个服务是否在运行、是否就绪",
    "服务单元处于 inactive 或 failed，需要执行一次启动或重启",
    "需要查看服务最近的日志而不改动任何状态"
  ],
  "notFor": [
    "需要修改服务登记表、单元文件或端口配置",
    "需要启动登记表里没有的进程",
    "需要 sudo、需要改动 tailscale serve 发布规则",
    "需要维护远程集群节点上的服务"
  ],
  "kind": "agent",
  "input": {
    "type": "object",
    "properties": {
      "task": {
        "type": "string",
        "maxLength": 8000,
        "description": "要检查或恢复什么，以及为什么。"
      },
      "service": {
        "type": "string",
        "maxLength": 128,
        "description": "登记表里的服务名称。省略时检查全部已登记服务。"
      },
      "allowRepair": {
        "type": "boolean",
        "description": "是否允许按登记表执行一次启动或重启。默认 false，只做只读检查。"
      }
    },
    "required": [
      "task"
    ],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "services": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "object",
          "properties": {
            "service": {
              "type": "string",
              "maxLength": 128,
              "description": "登记表里的服务名称。"
            },
            "healthy": {
              "type": "boolean",
              "description": "结束时该服务是否健康。"
            },
            "state": {
              "type": "string",
              "maxLength": 64,
              "description": "当前单元状态，例如 active、inactive、failed。"
            },
            "action": {
              "type": "string",
              "enum": [
                "none",
                "start",
                "restart"
              ],
              "description": "本次执行的动作。"
            },
            "message": {
              "type": "string",
              "maxLength": 500,
              "description": "一句话结果；仍不健康时说明原因。"
            }
          },
          "required": [
            "service",
            "healthy",
            "state",
            "action"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "services"
    ],
    "additionalProperties": false
  },
  "agent": {
    "instructions": "agent/AGENT.md",
    "workflow": "agent/WORKFLOW.md",
    "examples": "agent/EXAMPLES.md",
    "tools": [
      "read",
      "write",
      "bash",
      "grep",
      "find",
      "ls"
    ],
    "maxTurns": 20,
    "sessionScope": "project",
    "memoryScope": "project",
    "resolution": "user-first",
    "createProjectIfMissing": true,
    "requireProjectTrust": true,
    "contractRange": "^1.0.0"
  },
  "permissions": {
    "read": true,
    "write": true,
    "bash": true,
    "network": true
  },
  "limits": {
    "maxInputBytes": 65536,
    "maxResultBytes": 30000,
    "jobTimeoutMs": 600000,
    "jobIdleTimeoutMs": 0
  },
  "execution": {
    "defaultMode": "sync",
    "notifyOnIdle": false,
    "asyncByDefault": false
  },
  "exposure": "direct",
  "namespace": "tool"
}
