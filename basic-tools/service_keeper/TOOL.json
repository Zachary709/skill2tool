{
  "name": "service_keeper",
  "version": "2.0.0",
  "contractVersion": "2.0.0",
  "description": "检查并恢复已登记的本地服务和工具 daemon。",
  "whenToUse": [
    "本地服务异常、就绪检查或日志查询"
  ],
  "notFor": [
    "未登记的进程或远程服务",
    "修改服务配置、安装软件或执行 sudo"
  ],
  "kind": "agent",
  "input": {
    "type": "object",
    "properties": {
      "request": {
        "type": "string",
        "maxLength": 8000,
        "description": "直接写用户任务及必要条件，不扩写工具规则。"
      },
      "allowRepair": {
        "type": "boolean",
        "description": "允许一次启动或重启，默认 false。"
      }
    },
    "required": [
      "request"
    ],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "services": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "object",
          "properties": {
            "service": {
              "type": "string",
              "maxLength": 128,
              "description": "服务名称。"
            },
            "healthy": {
              "type": "boolean",
              "description": "是否健康。"
            },
            "state": {
              "type": "string",
              "maxLength": 64,
              "description": "当前状态。"
            },
            "action": {
              "type": "string",
              "enum": [
                "none",
                "start",
                "restart"
              ],
              "description": "执行的动作。"
            },
            "message": {
              "type": "string",
              "maxLength": 500,
              "description": "结果或失败原因。"
            }
          },
          "required": [
            "service",
            "healthy",
            "state",
            "action"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "services"
    ],
    "additionalProperties": false
  },
  "agent": {
    "instructions": "agent/AGENT.md",
    "workflow": "agent/WORKFLOW.md",
    "examples": "agent/EXAMPLES.md",
    "tools": [
      "read",
      "write",
      "bash",
      "grep",
      "find",
      "ls"
    ],
    "context": {
      "budgetTokens": 272000,
      "keepRecentTokens": 4000
    },
    "maxTurns": 20,
    "sessionScope": "project",
    "memoryScope": "project",
    "resolution": "user-first",
    "createProjectIfMissing": true,
    "requireProjectTrust": true,
    "contractRange": "^2.0.0"
  },
  "permissions": {
    "read": true,
    "write": true,
    "bash": true,
    "network": true
  },
  "limits": {
    "maxInputBytes": 65536,
    "maxResultBytes": 30000,
    "jobTimeoutMs": 600000,
    "jobIdleTimeoutMs": 0
  },
  "execution": {
    "defaultMode": "sync",
    "notifyOnIdle": false,
    "asyncByDefault": false
  },
  "exposure": "direct",
  "namespace": "tool",
  "handler": "service_keeper"
}
