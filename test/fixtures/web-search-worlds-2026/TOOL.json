{
  "name": "web_search",
  "version": "0.3.0",
  "contractVersion": "0.3.0",
  "description": "自主检索网络资料、读取来源并核实信息。",
  "whenToUse": [
    "需要搜索网络资料、阅读链接或核实来源时使用 web_search"
  ],
  "notFor": [],
  "kind": "agent",
  "input": {
    "type": "object",
    "properties": {
      "request": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8000,
        "description": "搜索或阅读需求及必要背景。"
      }
    },
    "required": [
      "request"
    ],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "answer": {
        "type": "string",
        "maxLength": 24000,
        "description": "直接回答需求，引用 sources 中的来源，并说明尚未核实的内容。"
      },
      "sources": {
        "type": "array",
        "maxItems": 64,
        "description": "符合需求且实际取得的来源证据，按 answer 中的引用顺序排列。",
        "items": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 500,
              "description": "来源标题。"
            },
            "url": {
              "type": "string",
              "maxLength": 4096,
              "description": "实际核实的来源网址。"
            },
            "evidence": {
              "type": "string",
              "enum": [
                "search_snippet",
                "page_text",
                "document_text",
                "api_response"
              ],
              "maxLength": 20,
              "description": "证据来自搜索摘要、网页正文、文档文本或 API 响应。"
            },
            "excerpt": {
              "type": "string",
              "maxLength": 2000,
              "description": "实际取得、与结论相关的原文片段或 API 字段。"
            },
            "publishedAt": {
              "type": "string",
              "maxLength": 100,
              "description": "来源明确提供的发布时间；未核实时为空。"
            },
            "accessedAt": {
              "type": "string",
              "maxLength": 40,
              "description": "实际读取该来源的 UTC 时间。"
            }
          },
          "required": [
            "title",
            "url",
            "evidence",
            "excerpt",
            "publishedAt",
            "accessedAt"
          ],
          "additionalProperties": false
        }
      },
      "limitations": {
        "type": "array",
        "maxItems": 32,
        "description": "影响答案完整性或可信度的访问限制和未核实事项。",
        "items": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "required": [
      "answer",
      "sources",
      "limitations"
    ],
    "additionalProperties": false
  },
  "agent": {
    "instructions": "AGENT.md",
    "workflow": "WORKFLOW.md",
    "examples": "EXAMPLES.md",
    "tools": [
      "read",
      "bash",
      "edit",
      "write",
      "grep",
      "find",
      "ls"
    ],
    "maxTurns": 30,
    "sessionScope": "user",
    "memoryScope": "user",
    "resolution": "user-first",
    "createProjectIfMissing": false,
    "requireProjectTrust": true,
    "contractRange": "^0.3.0"
  },
  "permissions": {
    "read": true,
    "write": true,
    "bash": true,
    "network": true
  },
  "limits": {
    "maxInputBytes": 65536,
    "maxResultBytes": 262144,
    "jobTimeoutMs": 600000,
    "jobIdleTimeoutMs": 0
  },
  "execution": {
    "defaultMode": "sync",
    "notifyOnIdle": false,
    "asyncByDefault": false
  },
  "exposure": "direct",
  "namespace": "tool"
}
