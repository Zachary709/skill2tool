{
  "name": "process_bash_agent",
  "version": "1.0.0",
  "description": "使用独立 agent 执行明确指定的 Bash 命令并返回真实输出。",
  "kind": "agent",
  "input": {
    "type": "object",
    "properties": { "command": { "type": "string", "description": "要执行的完整 Bash 命令。" } },
    "required": ["command"],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "exitCode": { "type": "number" },
      "stdout": { "type": "string", "maxLength": 4000 }
    },
    "required": ["exitCode", "stdout"],
    "additionalProperties": false
  },
  "agent": { "instructions": "BASH_AGENT.md", "workflow": "BASH_WORKFLOW.md", "tools": ["bash"] },
  "permissions": { "read": false, "write": false, "bash": true, "network": false },
  "execution": { "defaultMode": "sync" }
}
