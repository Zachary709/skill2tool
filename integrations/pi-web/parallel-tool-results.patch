index 0000000..3835db0
--- /dev/null
+++ b/e2e/parallel-tool-results.mjs
@@ -0,0 +1,179 @@
+import assert from "node:assert/strict";
+import { spawn } from "node:child_process";
+import { createHash } from "node:crypto";
+import { once } from "node:events";
+import { promises as fs } from "node:fs";
+import { createServer } from "node:net";
+import * as path from "node:path";
+import { setTimeout as delay } from "node:timers/promises";
+import { fileURLToPath } from "node:url";
+import { getAgentDir } from "@earendil-works/pi-coding-agent";
+
+const root = path.dirname(path.dirname(fileURLToPath(import.meta.url)));
+const projectRoot = process.env.PI_TOOL_RUNTIME_PROJECT;
+assert.ok(projectRoot, "需要 PI_TOOL_RUNTIME_PROJECT 指向工具运行时项目");
+const provider = process.env.PI_PROVIDER;
+const modelId = process.env.PI_MODEL;
+assert.ok(provider && modelId, "需要沿用当前会话的模型配置");
+const parent = path.join(projectRoot, "_intermediate", "agent-runtime-checks");
+await fs.mkdir(parent, { recursive: true });
+const directory = await fs.mkdtemp(path.join(parent, "web-tool-results-"));
+const temporary = path.join(directory, "intermediate");
+const agentDir = path.join(directory, "agent");
+const project = path.join(directory, "project");
+await Promise.all([temporary, agentDir, project].map((dir) => fs.mkdir(dir, { mode: 0o700 })));
+const currentAgentDir = getAgentDir();
+await fs.copyFile(path.join(currentAgentDir, "auth.json"), path.join(agentDir, "auth.json"));
+await fs.chmod(path.join(agentDir, "auth.json"), 0o600);
+await fs.copyFile(path.join(currentAgentDir, "models.json"), path.join(agentDir, "models.json"));
+await fs.chmod(path.join(agentDir, "models.json"), 0o600);
+await fs.copyFile(path.join(projectRoot, "README.md"), path.join(project, "README.md"));
+process.env.TMPDIR = temporary;
+const { chromium } = await import("playwright");
+const socket = createServer();
+socket.listen(0, "127.0.0.1");
+await once(socket, "listening");
+const port = socket.address().port;
+await new Promise((resolve, reject) => socket.close((error) => error ? reject(error) : resolve()));
+const base = `http://127.0.0.1:${port}`;
+const serverLog = await fs.open(path.join(directory, "server.log"), "a");
+const server = spawn(process.execPath, [path.join(root, "node_modules/next/dist/bin/next"), "start", "-H", "127.0.0.1", "-p", String(port)], {
+  cwd: root,
+  env: { ...process.env, TMPDIR: temporary, PI_CODING_AGENT_DIR: agentDir },
+  stdio: ["ignore", serverLog.fd, serverLog.fd],
+});
+const exited = once(server, "close");
+await serverLog.close();
+let browser;
+let page;
+let sessionId;
+const events = [];
+const pageErrors = [];
+const evidence = { directory, base, model: `${provider}/${modelId}` };
+
+async function until(condition, message) {
+  const deadline = Date.now() + 300000;
+  while (!await condition()) {
+    assert.equal(server.exitCode, null, await fs.readFile(path.join(directory, "server.log"), "utf8"));
+    const error = events.find((event) => event.type === "message_end" && event.message?.role === "assistant" && event.message.stopReason === "error");
+    assert.equal(error, undefined, error?.message?.errorMessage);
+    assert.deepEqual(pageErrors, []);
+    assert.ok(Date.now() < deadline, message);
+    await delay(50);
+  }
+}
+
+try {
+  await until(async () => {
+    try { return (await fetch(`${base}/api/web-auth`)).ok; }
+    catch (error) {
+      if (error.cause?.code === "ECONNREFUSED") return false;
+      throw error;
+    }
+  }, "等待独立 Pi Web 服务启动超时");
+  browser = await chromium.launch({ headless: true });
+  const context = await browser.newContext({ baseURL: base });
+  if (process.env.PI_WEB_PASSWORD) {
+    const login = await context.request.post("/api/web-auth", { data: { password: process.env.PI_WEB_PASSWORD } });
+    assert.ok(login.ok(), await login.text());
+  }
+  const target = path.join(project, "released.md");
+  const ready = path.join(project, "ready");
+  const command = [process.execPath, path.join(projectRoot, "test/fixtures/process-control/wait-file.mjs"), target, ready]
+    .map((value) => `'${value.replaceAll("'", "'\\''")}'`).join(" ");
+  const readInput = { path: path.join(project, "README.md"), offset: 1, limit: 5 };
+  const prompt = `在同一条回复中并行调用两个工具，严格按以下顺序发起。第一个 bash 的 command 是 ${JSON.stringify(command)}；它会等待文件。第二个 read 的输入是 ${JSON.stringify(readInput)}。必须在等待第一个工具之前同时发起第二个工具，不得串行等待，不要改写命令和输入，不调用其他工具。两者完成后简短说明真实结果。`;
+  const created = await context.request.post("/api/agent/new", { data: {
+    cwd: project, type: "prompt", message: prompt, provider, modelId,
+    thinkingLevel: process.env.PI_REASONING_LEVEL, toolNames: ["bash", "read"],
+  } });
+  assert.ok(created.ok(), await created.text());
+  sessionId = (await created.json()).sessionId;
+  assert.ok(sessionId);
+  page = await context.newPage();
+  page.on("pageerror", (error) => pageErrors.push(String(error)));
+  const cdp = await context.newCDPSession(page);
+  await cdp.send("Network.enable");
+  cdp.on("Network.eventSourceMessageReceived", ({ data }) => events.push(JSON.parse(data)));
+  await page.goto(`${base}/?session=${sessionId}`, { waitUntil: "domcontentloaded" });
+  await page.locator(".chat-input-textarea").waitFor();
+  await until(() => events.some((event) => event.type === "connected" && event.sessionId === sessionId), "页面没有连接真实事件流");
+
+  let readEnd;
+  let bashStart;
+  await until(async () => {
+    readEnd = events.find((event) => event.type === "tool_execution_end" && event.toolName === "read");
+    bashStart = events.find((event) => event.type === "tool_execution_start" && event.toolName === "bash");
+    return readEnd && bashStart && (await fs.readdir(project)).includes("ready");
+  }, "没有观察到同一批中的真实 bash 与 read 完成事件");
+  assert.equal(readEnd.isError, false);
+  assert.ok(readEnd.result?.content, "Web 事件必须包含已完成调用的结果内容");
+  assert.equal(events.some((event) => event.type === "tool_execution_end" && event.toolCallId === bashStart.toolCallId), false);
+  assert.equal(events.some((event) => event.type === "message_end" && event.message?.role === "toolResult"), false);
+  const expected = (await fs.readFile(path.join(project, "README.md"), "utf8")).split("\n")[0];
+  const expectedResult = readEnd.result.content.filter((part) => part.type === "text").map((part) => part.text).join("\n");
+
+  async function checkReadCard() {
+    const header = page.getByRole("button", { name: /^read/ });
+    await header.waitFor();
+    assert.equal(await header.count(), 1);
+    const card = header.locator("..").locator("..");
+    if (!await card.evaluate((element) => element.children.length > 1)) await header.click();
+    await until(async () => (await card.textContent())?.includes(expected), "已完成 read 的原工具卡片没有显示实际文件内容");
+    const text = await card.textContent();
+    assert.ok(text.includes(expected));
+    assert.equal(text.split(expected).length - 1, 1, "原工具卡片中的结果不能重复出现");
+    return text;
+  }
+
+  evidence.cardWhileBashRunning = await checkReadCard();
+  console.log("已验证：慢调用仍在运行时，read 的原工具卡片立即显示真实结果。");
+  const offset = events.length;
+  await page.reload({ waitUntil: "domcontentloaded" });
+  await until(() => events.slice(offset).some((event) => event.type === "tool_execution_end" && event.toolCallId === readEnd.toolCallId && event.result?.content), "刷新后没有重放已经完成的工具结果");
+  evidence.cardAfterReload = await checkReadCard();
+  assert.equal(events.some((event) => event.type === "tool_execution_end" && event.toolCallId === bashStart.toolCallId), false);
+  console.log("已验证：刷新页面后，已完成结果仍在原工具卡片中，慢调用继续运行。");
+  await fs.copyFile(path.join(project, "README.md"), path.join(project, "incoming"));
+  await fs.rename(path.join(project, "incoming"), target);
+  await until(() => events.some((event) => event.type === "agent_settled"), "实际命令完成后会话没有结束");
+  const bashEnd = events.find((event) => event.type === "tool_execution_end" && event.toolCallId === bashStart.toolCallId);
+  assert.ok(bashEnd);
+  const digest = createHash("sha256").update(await fs.readFile(target)).digest("hex");
+  assert.ok(bashEnd.result.content.some((part) => part.type === "text" && part.text.includes(digest)));
+  const canonical = events.filter((event) => event.type === "message_end" && event.message?.role === "toolResult");
+  for (const id of [readEnd.toolCallId, bashStart.toolCallId]) assert.equal(canonical.filter((event) => event.message.toolCallId === id).length, 1);
+  assert.equal(canonical.find((event) => event.message.toolCallId === readEnd.toolCallId).message.content.filter((part) => part.type === "text").map((part) => part.text).join("\n"), expectedResult);
+  const contextReply = await context.request.get(`/api/sessions/${sessionId}/context`);
+  assert.ok(contextReply.ok(), await contextReply.text());
+  const { context: history } = await contextReply.json();
+  for (const id of [readEnd.toolCallId, bashStart.toolCallId]) {
+    assert.equal(history.messages.filter((message) => message.role === "toolResult" && message.toolCallId === id).length, 1);
+  }
+  evidence.status = "passed";
+  evidence.toolCalls = { read: readEnd.toolCallId, bash: bashStart.toolCallId };
+  console.log("已验证：正式结果与提前显示的结果一致，历史中每个调用只保存一次结果。");
+} catch (error) {
+  evidence.error = String(error);
+  if (page && !page.isClosed()) {
+    evidence.pageUrl = page.url();
+    evidence.pageText = await page.locator("body").innerText();
+    evidence.buttons = await page.getByRole("button").allTextContents();
+  }
+  throw error;
+} finally {
+  await browser?.close();
+  try {
+    if (sessionId && server.exitCode === null) {
+      const stopped = await fetch(`${base}/api/agent/${sessionId}`, { method: "POST", headers: { "Content-Type": "application/json",
+        ...(process.env.PI_WEB_PASSWORD ? { Authorization: `Basic ${Buffer.from(`:${process.env.PI_WEB_PASSWORD}`).toString("base64")}` } : {}) }, body: JSON.stringify({ type: "abort" }) });
+      assert.ok(stopped.ok, await stopped.text());
+    }
+  } finally {
+    if (server.exitCode === null) server.kill("SIGTERM");
+    await exited;
+    await fs.rm(agentDir, { recursive: true, force: true });
+    await fs.writeFile(path.join(directory, "verification.json"), JSON.stringify({ ...evidence, events, pageErrors }, null, 2));
+    console.log(`验收证据：${path.join(directory, "verification.json")}`);
+  }
+}
