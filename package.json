{
  "name": "@zachary709/pi-tool-runtime",
  "version": "0.1.0",
  "description": "Agent-backed and direct tools for Pi with persistent workers, async jobs, and normalized contracts.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "agent",
    "tools"
  ],
  "pi": {
    "extensions": [
      "./extensions/tool-runtime.ts"
    ]
  },
  "exports": {
    ".": "./extensions/tool-runtime.ts"
  },
  "files": [
    "extensions",
    "src",
    "basic-tools",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2",
    "undici": "8.12.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
